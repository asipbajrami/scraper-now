# Comma-separated proxy URLs.
# Example: http://user:pass@dc-proxy-1:8000,http://user:pass@dc-proxy-2:8000
DATACENTER_PROXY_URLS=
RESIDENTIAL_PROXY_URLS=

# Optional runtime tuning
HTTP_CONCURRENCY=30
BROWSER_CONCURRENCY=5
STEALTH_CONCURRENCY=2
HTTP_TIMEOUT_MS=30000

# Optional default paths
SEED_URL_FILE=inputs/urls.txt
OUTPUT_FILE=output/results.ndjson
